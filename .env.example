# Aegis-DAST environment configuration (copy to .env; .env is git-ignored)

# AI engine is OPTIONAL. With no key set, Aegis runs fully rule-based.
# Choose a provider with `--ai claude|openai|none` (default: auto-detect).

# Anthropic Claude (default AI provider)
ANTHROPIC_API_KEY=
AEGIS_CLAUDE_MODEL=claude-opus-4-8

# OpenAI (optional alternative)
OPENAI_API_KEY=
AEGIS_OPENAI_MODEL=gpt-4o-mini
